# ---------------------------------------------------------------------------
# ConnectMe specific
# ---------------------------------------------------------------------------

# Release signing material and the Firebase *service account* must never be
# committed. Note that `lib/firebase_options.dart` IS committed on purpose:
# it holds only the public Firebase web/API identifiers, which are designed to
# ship inside the app binary (FlutterFire's own template does the same). The
# genuinely sensitive files are the ones listed here.
android/key.properties
android/app/google-services.json
**/google-services.json
**/GoogleService-Info.plist
android/local.properties
**/serviceAccount*.json
*-firebase-adminsdk-*.json
*.jks
*.keystore

# Firebase App Distribution artifacts
*.aab
app-release.apk
app-debug.apk
